{
  "model": {
    "type": "minecraft:condition",
    "property": "bodycam:empty",
    "on_true": {
      "type": "minecraft:model",
      "model": "bodycam:item/jammer/jammer_empty"
    },
    "on_false": {
      "type": "minecraft:range_dispatch",
      "property": "bodycam:mode",
      "entries": [
        {
          "threshold": 0.5,
          "model": {
            "type": "minecraft:model",
            "model": "bodycam:item/jammer/jammer_on"
          }
        },
        {
          "threshold": 1.5,
          "model": {
            "type": "minecraft:model",
            "model": "bodycam:item/jammer/jammer_limited"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "bodycam:item/jammer"
      }
    }
  }
}
