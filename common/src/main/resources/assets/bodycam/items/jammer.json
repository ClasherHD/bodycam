{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "bodycam:jammer_mode",
    "cases": [
      {
        "when": 1,
        "model": {
          "type": "minecraft:model",
          "model": "bodycam:item/jammer_on"
        }
      },
      {
        "when": 2,
        "model": {
          "type": "minecraft:model",
          "model": "bodycam:item/jammer_limited"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "bodycam:item/jammer"
    }
  }
}
